# DTS
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y

# F2FS
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y

# Haptics
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_QPNP_HAPTIC=y

# ION
CONFIG_ION_LEGACY=y

# UART
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Wi-Fi
CONFIG_QCA_CLD_WLAN=y
